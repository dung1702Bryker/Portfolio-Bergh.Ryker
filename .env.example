# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# AI Models
GEMINI_API_KEY=

# SePay Integration
SEPAY_API_TOKEN=

# Cloudinary Image Delivery & Transformations (Optional)
VITE_CLOUDINARY_CLOUD_NAME=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public Booking Confirmation Base URL: Enforces official public domain for QR code generation
# Ensures phones (4G, Safari, Android) can scan and view bookings without dev/google login blocks.
PUBLIC_BOOKING_BASE_URL=https://ais-pre-hfmviuhpqhhx673vbwoye2-841267057913.asia-east1.run.app
VITE_PUBLIC_BOOKING_BASE_URL=https://ais-pre-hfmviuhpqhhx673vbwoye2-841267057913.asia-east1.run.app

# Google Sheets Webhook Integration (Google Apps Script Web App URL)
# URL webhook tự động đẩy dữ liệu đặt lịch sang Google Sheets
VITE_GOOGLE_SHEET_WEBHOOK_URL=
